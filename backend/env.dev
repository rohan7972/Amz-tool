NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database Configuration (Local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_db_password
DB_NAME=amazon_fdc_tool

# JWT Secrets
JWT_SECRET=dev_secret_key_12345
JWT_EXPIRES_IN=7d

# Redis (Optional/Local)
# If you don't have redis, some features might fallback or fail silently depending on implementation
REDIS_URL=redis://localhost:6379

# Amazon API (Placeholders)
AMAZON_SELLING_PARTNER_APP_ID=
AMAZON_SELLING_PARTNER_APP_SECRET=
AMAZON_AWS_ACCESS_KEY_ID=
AMAZON_AWS_SECRET_ACCESS_KEY=
AMAZON_AWS_REGION=us-east-1
AMAZON_ROLE_ARN=
