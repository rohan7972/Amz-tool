# Example Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit actual credentials to version control

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://amazon_fdc_user:YOUR_SECURE_PASSWORD@postgres:5432/amazon_fdc_db
DB_HOST=postgres
DB_PORT=5432
DB_NAME=amazon_fdc_db
DB_USER=amazon_fdc_user
DB_PASSWORD=YOUR_SECURE_PASSWORD

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=production
PORT=3001
API_BASE_URL=https://your-domain.com/api

# ============================================================================
# JWT Configuration
# ============================================================================
# Generate secure keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS
JWT_REFRESH_SECRET=YOUR_SUPER_SECURE_REFRESH_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# Amazon SP-API Configuration
# ============================================================================
# Get these from your Amazon seller account developer settings
AMAZON_CLIENT_ID=YOUR_AMAZON_CLIENT_ID
AMAZON_CLIENT_SECRET=YOUR_AMAZON_CLIENT_SECRET
AMAZON_REFRESH_TOKEN=YOUR_AMAZON_REFRESH_TOKEN
AMAZON_REGION=us-east-1
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# ============================================================================
# Amazon Advertising API Configuration
# ============================================================================
# Separate credentials for Amazon Advertising API
AMAZON_AD_CLIENT_ID=YOUR_AMAZON_AD_CLIENT_ID
AMAZON_AD_CLIENT_SECRET=YOUR_AMAZON_AD_CLIENT_SECRET
AMAZON_AD_REFRESH_TOKEN=YOUR_AMAZON_AD_REFRESH_TOKEN

# ============================================================================
# Email Configuration (SMTP)
# ============================================================================
# Example shown for Gmail. Adjust for your email provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD_NOT_GMAIL_PASSWORD

# ============================================================================
# Application URLs
# ============================================================================
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com/api

# ============================================================================
# Security Configuration
# ============================================================================
CORS_ORIGIN=https://your-domain.com
SESSION_SECRET=YOUR_SESSION_SECRET_KEY_HERE

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# File Upload Configuration
# ============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# ============================================================================
# Monitoring & Health Checks
# ============================================================================
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# ============================================================================
# Optional: OAuth Configuration (if using Google OAuth)
# ============================================================================
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ============================================================================
# Optional: Webhook Configuration
# ============================================================================
# WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
# WEBHOOK_URL=https://your-domain.com/webhooks

# ============================================================================
# Optional: Slack Integration
# ============================================================================
# SLACK_BOT_TOKEN=xoxb-YOUR-TOKEN
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...

# ============================================================================
# Optional: SMS Configuration (if using SMS notifications)
# ============================================================================
# TWILIO_ACCOUNT_SID=YOUR_ACCOUNT_SID
# TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN
# TWILIO_FROM_NUMBER=+1234567890
